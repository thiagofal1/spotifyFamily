        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_DEMO",
          "name": "Google Sheets Demo"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.all().map(item => item.json);\nconst names = ['Pessoa A', 'Pessoa B', 'Pessoa C'];\nconst participants = data.filter(item => names.includes(String(item.Pessoas ?? '').trim()));\n\nif (participants.length !== names.length) {\n  throw new Error('Demo expects three fictional participants.');\n}\n\nconst message = participants.map(person => {\n  const status = String(person['Situação'] ?? 'Sem status');\n  return `${status === 'Em dia' ? 'OK' : 'PENDENTE'} - ${person.Pessoas}: ${status}`;\n}).join('\\n');\n\nreturn [{\n  json: {\n    message: `Resumo demonstrativo de pagamentos\\n\\n${message}`,\n    recipient: 'PHONE_NUMBER_OR_GROUP_ID_DEMO'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "code-node-demo",
      "name": "Build notification"
    },
    {
      "parameters": {
