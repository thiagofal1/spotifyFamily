TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_RUNNERS_ENABLED=true

EVOLUTION_AUTHENTICATION_API_KEY=replace-with-a-long-random-api-key
EVOLUTION_SERVER_PORT=8080
EVOLUTION_SERVER_URL=http://127.0.0.1:8080
EVOLUTION_DATABASE_ENABLED=true
EVOLUTION_DATABASE_PROVIDER=postgresql
EVOLUTION_DATABASE_CONNECTION_URI=postgresql://evolution_user:replace-with-db-password@evolution-postgres:5432/evolution?schema=public
EVOLUTION_DATABASE_CONNECTION_CLIENT_NAME=spotify_family
EVOLUTION_DATABASE_SAVE_DATA_INSTANCE=true
EVOLUTION_DATABASE_SAVE_DATA_NEW_MESSAGE=true
EVOLUTION_DATABASE_SAVE_MESSAGE_UPDATE=true
EVOLUTION_DATABASE_SAVE_DATA_CONTACTS=true
EVOLUTION_DATABASE_SAVE_DATA_CHATS=true
EVOLUTION_DATABASE_SAVE_DATA_LABELS=true
EVOLUTION_DATABASE_SAVE_DATA_HISTORIC=true
EVOLUTION_CACHE_REDIS_ENABLED=true
EVOLUTION_CACHE_REDIS_URI=redis://evolution-redis:6379/6
EVOLUTION_CACHE_REDIS_PREFIX_KEY=spotify_family
EVOLUTION_CACHE_REDIS_SAVE_INSTANCES=false
EVOLUTION_CACHE_LOCAL_ENABLED=false
EVOLUTION_POSTGRES_DATABASE=evolution
EVOLUTION_POSTGRES_USERNAME=evolution_user
EVOLUTION_POSTGRES_PASSWORD=replace-with-db-password
